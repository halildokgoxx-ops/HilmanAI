.env*.local
.env.production

# Yerel JSON veritabanı (kullanıcı geçmişleri, anahtarlar, ayarlar)
data/*.json
!data/.gitkeep

# TypeScript / ESLint önbellek
*.tsbuildinfo
.eslintcache

# İşletim sistemi / editör
.DS_Store
Thumbs.db
.vscode/
.idea/

# Loglar
*.log
logs/
